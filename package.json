{
  "name": "vinskapet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "collection:dry-run": "node scripts/import-real-collection.mjs",
    "collection:import": "CONFIRM_COLLECTION_RESET=DELETE_AND_IMPORT_19_WINES node scripts/import-real-collection.mjs --apply",
    "metadata:audit": "node scripts/enrich-missing-wines.mjs",
    "metadata:enrich": "CONFIRM_METADATA_ENRICHMENT=ENRICH_MISSING_WINE_METADATA node scripts/enrich-missing-wines.mjs --apply",
    "systembolaget:index": "node scripts/update-systembolaget-index.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "@supabase/supabase-js": "^2.109.0",
    "@zxing/browser": "^0.2.1",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.8",
    "ws": "^8.22.0"
  }
}
